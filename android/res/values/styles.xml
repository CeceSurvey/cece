<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand_dark</item>
        <item name="android:colorAccent">@color/brand_light</item>
        <!-- 状态栏 / 导航栏 / 窗口背景统一用页面底色，横屏时即使露出也不会是刺眼的深色条 -->
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:navigationBarColor">@color/page_bg</item>
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>
