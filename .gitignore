# ============================================================
# 测策 · 工程测量 — .gitignore
# 关键红线：任何签名密钥/证书都绝不能进入 Git 仓库
# ============================================================

# --- 签名密钥与证书（最高优先级，绝对排除）---
*.jks
*.keystore
*.p12
*.pfx
*.key
*.pem
keystore/
**/keystore/

# --- 构建产物 ---
dist/
build/
out/
*.apk
*.aab
*.hap
*.app
*.ipa

# --- 历史备份（体积大且含旧版签名密钥）---
backup/

# --- 官网目录（独立仓库，不进入主程序仓库）---
website/

# --- 助手工作记忆（工具内部文件，绝不进公开仓库）---
.workbuddy/

# --- 鸿蒙构建缓存与产物 ---
.hvigor/

# --- 鸿蒙版本（不公开发布）---
harmony/
harmony-native/
docs/鸿蒙打包指南.md

# --- 软著申请材料（不公开）---
软著材料/

# --- 依赖与工具链 ---
node_modules/
.gradle/
*.class
*.jar

# --- 系统与编辑器杂项 ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.log

# --- 本地环境变量（若未来接入第三方服务）---
.env
.env.local
.env.*.local
